<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:elevation="4dp"
    android:padding="16dp"
    android:layout_marginBottom="16dp">


    <!-- Add your fields like Total Beds, Rent, etc. -->

    <TextView android:id="@+id/propertyNameText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/totalBedsText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/availableBedsText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/rentPerBedText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/contactText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/upiText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/distanceText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

</LinearLayout>