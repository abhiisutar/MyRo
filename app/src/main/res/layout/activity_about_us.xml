<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:fillViewport="true"
    android:clipToPadding="false">

    <!-- Main container with invisible border constraints -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="24dp"
        android:clipToPadding="true">

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp"
            android:paddingStart="4dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/home_icon"
                android:contentDescription="MyRo logo"
                app:tint="@color/purple" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MyRo"
                android:textSize="28sp"
                android:textColor="@color/purple"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-condensed"/>
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find Your Perfect Student Accommodation"
            android:textSize="22sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:paddingStart="4dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simple, fast, and reliable way to book hostels and rooms"
            android:textSize="16sp"
            android:textColor="@color/gray"
            android:layout_marginBottom="32dp"
            android:lineSpacingExtra="4dp"
            android:paddingStart="4dp"/>

        <!-- Horizontal ScrollView with constrained width -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingVertical="8dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingEnd="24dp">

                <!-- Card 1: About the App -->
                <androidx.cardview.widget.CardView
                    android:layout_width="280dp"
                    android:layout_height="300dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/purple"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="20dp"

                            android:contentDescription="About icon"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="About MyRo"
                            android:textSize="20sp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MyRo is a student-focused platform connecting renters with affordable, quality accommodations near campuses nationwide."
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:lineSpacingExtra="6dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 2: How to Use -->
                <androidx.cardview.widget.CardView
                    android:layout_width="280dp"
                    android:layout_height="300dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/teal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"

                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="20dp"
                            android:contentDescription="How to use icon"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="How to Use"
                            android:textSize="20sp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1. Search for locations\n2. View room details\n3. Book instantly\n4. Move in hassle-free"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:lineSpacingExtra="6dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 3: Our Goals -->
                <androidx.cardview.widget.CardView
                    android:layout_width="280dp"
                    android:layout_height="300dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/blue"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="20dp"
                            android:contentDescription="Mission icon"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Our Mission"
                            android:textSize="20sp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="We aim to simplify student housing by providing verified listings, transparent pricing, and a seamless booking experience."
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:lineSpacingExtra="6dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Get Started Button -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/purple"
            android:textColor="@color/white"
            android:paddingVertical="16dp"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>
</ScrollView>